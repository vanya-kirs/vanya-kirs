# Telethon — get from https://my.telegram.org/apps
API_ID=0
API_HASH=

# Telethon StringSession — generate with: make generate-session
SESSION_STRING=

# Telegram Bot token — get from @BotFather
BOT_TOKEN=

# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL=postgresql+asyncpg://tgparser:tgparser@postgres:5432/tgparser

# Redis — matches docker-compose.yml defaults
REDIS_URL=redis://redis:6379/0

# Anthropic — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_RATE_LIMIT_WAIT_SECONDS=60
CLAUDE_BATCH_ITEM_DELAY_SECONDS=0.5

# Schedules
# How often (minutes) to process the channel join queue
PROCESS_JOIN_QUEUE_EVERY_MINUTES=5

# Docker Compose service URLs
API_BASE_URL=http://api:8000
# Generate with openssl rand -hex 32
SECRET_KEY=
OWNER_TELEGRAM_ID=0
